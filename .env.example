# ============================================================
# Supabase — Required
# ============================================================
# Find these in: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ============================================================
# Supabase — Optional (server-side only, never expose to client)
# ============================================================
# Not required by Planitary today. Uncomment only if you add
# service-role operations (admin tasks, webhooks, etc.).
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================================
# OpenRouter — Required for the Journal Standup AI feature
# ============================================================
# Get a key at https://openrouter.ai/keys
# Server-only — never expose these to the browser (no NEXT_PUBLIC_ prefix).
OPENROUTER_API_KEY=

# Fixed primary/fallback model IDs.
# Do NOT set either to "openrouter/free" — that auto-router picks a different
# underlying model on every request (inconsistent Standup tone/formatting).
# The app tries "openrouter/free" automatically as a last resort when both
# configured models fail.
# Free model availability changes often; if Standup returns MODEL_UNAVAILABLE,
# pick current free IDs from https://openrouter.ai/models
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_FALLBACK_MODEL=google/gemma-4-31b-it:free

# ============================================================
# Site URL — Required for correct SEO / social metadata in production
# ============================================================
# Canonical public origin (no trailing slash). Used for metadataBase,
# Open Graph/Twitter URLs, sitemap.xml, robots.txt, and OpenRouter
# HTTP-Referer attribution.
# Local default is fine for development; set your real domain in deploy.
# Server-only — no NEXT_PUBLIC_ prefix.
SITE_URL=http://localhost:3000

# ============================================================
# Supabase Auth — Redirect URL configuration
# ============================================================
# In your Supabase Dashboard → Authentication → URL Configuration, add:
#
#   Site URL:
#     http://localhost:3000          (development)
#     https://your-domain.com        (production)
#
#   Redirect URLs (allow list):
#     http://localhost:3000/auth/callback
#     https://your-domain.com/auth/callback
#
# The app's callback handler lives at /auth/callback and is already wired.
